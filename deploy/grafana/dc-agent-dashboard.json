{
  "title": "dc-agent",
  "uid": "dc-agent",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(dc_agent_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(dc_agent_answers_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failures by kind",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(dc_agent_failures_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 node latency (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(dc_agent_node_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 LLM latency (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dc_agent_llm_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "p95 query latency by engine (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dialect) (rate(dc_agent_query_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Plan cache hit ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(dc_agent_plan_cache_total{result=\"hit\"}[15m])) / clamp_min(sum(rate(dc_agent_plan_cache_total[15m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Grounding",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(dc_agent_grounding_total[15m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Cost gate and approvals",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (decision) (rate(dc_agent_cost_gate_total[15m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Breaker openings",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (name) (increase(dc_agent_breaker_opened_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Rate limited",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(dc_agent_rate_limited_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Feedback",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (rating) (increase(dc_agent_feedback_total[1d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Ontology problems",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "dc_agent_ontology_problems",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Shared backend fallbacks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum by (backend) (increase(dc_agent_backend_fallback_total[1h]))",
          "refId": "A"
        }
      ]
    }
  ]
}
